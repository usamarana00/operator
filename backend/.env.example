# --- Database ---
# Neon Postgres connection string (pooler URL recommended)
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Local dev override (docker-compose)
# NEON_DATABASE_URL=postgresql://freelance:freelance@localhost:5432/freelance_agent

# --- Auth ---
# Shared secret with NextAuth — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NEXTAUTH_SECRET=change-me

# Encryption key for storing user secrets — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=change-me

# Allowed CORS origin (your Vercel URL in prod, localhost in dev)
FRONTEND_ORIGIN=http://localhost:3000

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=freelance-agent-prod

# Local dev: point at LocalStack
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_S3_BUCKET=freelance-agent-dev

# --- LLM / Search ---
# Per-user OpenAI keys are stored encrypted in the DB.
# This fallback is only used for the server-side setup/build step.
OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...
